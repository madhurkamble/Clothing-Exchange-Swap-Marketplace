{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "^/login$",
      "dest": "/frontend/login.html"
    },
    {
      "src": "^/register$",
      "dest": "/frontend/register.html"
    },
    {
      "src": "^/dashboard$",
      "dest": "/frontend/dashboard.html"
    },
    {
      "src": "^/listings$",
      "dest": "/frontend/listings.html"
    },
    {
      "src": "^/item-details$",
      "dest": "/frontend/item-details.html"
    },
    {
      "src": "^/swap-requests$",
      "dest": "/frontend/swap-requests.html"
    },
    {
      "src": "^/chat$",
      "dest": "/frontend/chat.html"
    },
    {
      "src": "^/admin$",
      "dest": "/frontend/admin.html"
    },
    {
      "src": "^/$",
      "dest": "/frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/$1"
    }
  ]
}
